# ============================================================================
# Lawas Journeys - environment configuration (.env)
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# CORS_ORIGIN (Gunakan * untuk development lokal, ganti dengan URL Vercel saat production)
CORS_ORIGIN=*

SERVE_FRONTEND=false

# --- Database ---------------------------------------------------------------
# 1. DATABASE_URL untuk Supabase (PostgreSQL)
DATABASE_URL=postgresql://postgres.hwhqsgtmwxpnwddihzkw:Moen14sameya@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# 2. DATABASE_PATH (Biarkan saja untuk sementara agar env.config.js tidak error saat membaca file lama)
DATABASE_PATH=./database/lawas-journeys.sqlite

AUTO_SEED=true

# --- Authentication ---------------------------------------------------------
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN_HOURS=24

ADMIN_NAME=Lawas Admin
ADMIN_EMAIL=admin@lawasjourneys.com
ADMIN_PASSWORD=admin12345

# --- Payment gateway --------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_GATEWAY_SERVER_KEY=isi_server_key_anda
PAYMENT_GATEWAY_CLIENT_KEY=isi_client_key_anda
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_SIMULATION=true

# --- WhatsApp Business ------------------------------------------------------
WHATSAPP_API_PROVIDER=wa_link
WHATSAPP_API_TOKEN=isi_token_anda
WHATSAPP_BUSINESS_NUMBER=6281234567890