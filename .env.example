# ============================================================================
# Lawas Journeys - environment configuration
# Copy this file to ".env" and adjust the values:  cp .env.example .env
# Never commit the real ".env" file (it is already listed in .gitignore).
# ============================================================================

# --- Server -----------------------------------------------------------------
# Port the API listens on. Change it if 3000 is already used on your machine
# (remember to update API_BASE_URL in frontend/.env.local (NEXT_PUBLIC_API_BASE_URL) as well).
PORT=3000

# "development" prints request logs and detailed errors, "production" hides them.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API (CORS).
# Use "*" while developing with Live Server; list explicit origins in production.
CORS_ORIGIN=*

# Serve the legacy ../frontend-legacy HTML folder from this server too (http://localhost:3000).
# Handy when you do not want to use Live Server. true | false
SERVE_FRONTEND=false

# --- Database ---------------------------------------------------------------
# SQLite file location, relative to the backend folder. Created automatically.
DATABASE_PATH=./database/lawas-journeys.sqlite

# Insert the demo packages, destinations, articles and bookings on the very
# first start (only when the database is empty). true | false
AUTO_SEED=true

# --- Authentication ---------------------------------------------------------
# Secret used to sign login tokens. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-development-secret
# How long a login token stays valid, in hours.
JWT_EXPIRES_IN_HOURS=24

# Admin account created by the seeder (used to sign in to /admin on the Next.js frontend).
# Change the password before deploying anywhere public.
ADMIN_NAME=Lawas Admin
ADMIN_EMAIL=admin@lawasjourneys.com
ADMIN_PASSWORD=admin12345

# --- Payment gateway (Midtrans / Xendit ready) ------------------------------
# Provider name, kept for documentation and logs: midtrans | xendit
PAYMENT_GATEWAY_PROVIDER=midtrans
# Server key from your gateway dashboard. Keep it secret, it never reaches the browser.
PAYMENT_GATEWAY_SERVER_KEY=isi_server_key_anda
# Client key from your gateway dashboard (safe to expose to the browser).
PAYMENT_GATEWAY_CLIENT_KEY=isi_client_key_anda
# sandbox = testing keys, production = real money.
PAYMENT_GATEWAY_MODE=sandbox
# true  = use the built-in payment simulator (no real gateway call).
# false = disable the simulator once payment.service.js calls the real gateway.
PAYMENT_SIMULATION=true

# --- WhatsApp Business ------------------------------------------------------
# Integration provider: wa_business_api (official Cloud API) | wa_link (wa.me link)
WHATSAPP_API_PROVIDER=wa_business_api
# Permanent access token from Meta for Developers. Not required while the
# service falls back to wa.me links.
WHATSAPP_API_TOKEN=isi_token_anda
# Business number in international format without "+" or spaces, e.g. 6281234567890.
# Used by the floating WhatsApp button and the booking confirmation message.
WHATSAPP_BUSINESS_NUMBER=628xxxxxxxxxx
