{
  "name": "lawas-journeys-backend",
  "version": "1.0.0",
  "description": "REST API for the Lawas Journeys heritage travel booking platform",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
